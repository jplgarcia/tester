# Copy to .env and fill in values before running tests.
# Portal/utility defaults below target Cartesi Rollups node v2.0.0-alpha.13
# with rollups-contracts v3.0.0-alpha.10 (deterministic deployment: the same
# addresses on the devnet, Sepolia, Base Sepolia and OP Sepolia). Refresh them
# with `cartesi address-book` if you run against another stack.

# ── Required: set these from `cartesi run` output ──────────────────────────────
CARTESI_APP_ADDRESS=

# ── Required: set these from `forge script Deploy.s.sol` output ───────────────
TEST_ERC20_ADDRESS=
TEST_ERC721_ADDRESS=
TEST_ERC1155_ADDRESS=
MINTABLE_ERC721_ADDRESS=
DELEGATE_VOUCHER_LOGIC_ADDRESS=

# ── Optional: override if using a non-default setup ───────────────────────────
# cartesi run proxies everything through http://127.0.0.1:6751:
#   Anvil RPC  → http://127.0.0.1:6751/anvil
#   Node RPC   → http://127.0.0.1:6751/rpc
#   Inspect    → http://127.0.0.1:6751/inspect/<dapp-name>
RPC_URL=http://127.0.0.1:6751/anvil
NODE_RPC_URL=http://127.0.0.1:6751/rpc
INSPECT_URL=http://127.0.0.1:6751/inspect/tester
PRIVATE_KEY=
# Second Anvil account — used to assert targeted delegate vouchers revert for non-allowed executors
OTHER_PRIVATE_KEY=

# ── Voucher execution tests (suite 08) ─────────────────────────────────────────
# Run cartesi with a short epoch so proofs are available quickly:
#   cartesi run --epoch-length 5
# Then set EPOCH_LENGTH to match:
EPOCH_LENGTH=5

# ── address-book values for node v2.0.0-alpha.13 / contracts v3.0.0-alpha.10 ──
INPUT_BOX_ADDRESS=0xEbE9f4Dfc04ae10bBeE663859c3dc5A23f94eA3C
ETH_PORTAL_ADDRESS=0x035b11Be55656c6cfC822D1CaE568C1Af2e497b0
ERC20_PORTAL_ADDRESS=0x3332DE61a8BB9aC84893b2f552Fe81C9a6dC5419
ERC721_PORTAL_ADDRESS=0x397c352d18DFf47CC8a6143403142cf7afd5Ff7E
ERC1155_SINGLE_PORTAL=0x585F56351A66f131E176a345662215C772f80451
ERC1155_BATCH_PORTAL=0xee33550a22e3Cf6Cc265524dC9bcfD99D2307EBe
