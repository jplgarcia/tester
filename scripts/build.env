# Pinned inputs of the snapshot build (sourced by scripts/build-snapshot.sh and CI).
# Changing any value here changes the template hash.

# Emulator that builds the snapshot. Must be the emulator of the target node:
# rollups-node v2.0.0-alpha.13 uses cartesi-machine 0.21.0.
EMULATOR_VERSION=0.21.0
EMULATOR_IMAGE=cartesi/machine-emulator:0.21.0@sha256:880f9cbfea192e68f3e547ab27cbd54af8ab8247381c6f7ece912342f110e5a2

# Only xgenext2fs (1.5.6) is used from this image, with the same flags as
# `cartesi build`; its own emulator is not used.
XGENEXT2FS_IMAGE=cartesi/sdk:0.12.0-alpha.41@sha256:c58bff9e03815cad3a2d8a260e8a22db1c7056c16aa586306df7d420fbd29b41

# Kernel and rootfs-tools of the node tag (test/dependencies of
# rollups-node v2.0.0-alpha.13); checksums in scripts/dependencies.sha256.
KERNEL_FILE=linux-6.5.13-ctsi-2-v0.21.0.bin
KERNEL_URL=https://github.com/cartesi/machine-linux-image/releases/download/v0.21.0/linux-6.5.13-ctsi-2-v0.21.0.bin
ROOTFS_TOOLS_FILE=rootfs-tools.ext2
ROOTFS_TOOLS_URL=https://github.com/cartesi/machine-guest-tools/releases/download/v0.18.0/rootfs-tools.ext2

# Timestamp for every file of the root filesystem (BuildKit SOURCE_DATE_EPOCH)
# and for the release tarball: 2025-09-15T00:00:00Z, the day of the apt snapshot.
SOURCE_DATE_EPOCH=1757894400

# Machine configuration (same options `cartesi build` passes for this image)
RAM_LENGTH=128Mi
ENTRYPOINT=/opt/cartesi/dapp/dapp
WORKDIR=/opt/cartesi/dapp
GUEST_PATH=/opt/cartesi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
